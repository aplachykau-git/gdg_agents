# Google API Key for outpainting and agent logic (Vertex AI or Gemini Developer Key)
GEMINI_API_KEY=your_gemini_api_key_here

# Path to Google Cloud Service Account JSON key (required for Veo video generation)
GOOGLE_APPLICATION_CREDENTIALS=assets/your_service_account_key_here.json

# Toggle Veo video generation (costs tokens).
# Set to "true" to run actual Veo generations, or "false" to reuse "assets/Video_example.mp4" in dry-run mode.
ENABLE_VIDEO_GENERATION=false

# Toggle individual rendering pipeline formats (true/false)
RENDER_ORDINARY=true
RENDER_GIF=true
RENDER_4K=true
