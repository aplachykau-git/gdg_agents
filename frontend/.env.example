# ==============================================================================
# 🌐 Community Studio Frontend - Environment Configuration (.env)
# ==============================================================================
# Copy this file to frontend/.env or configure in your deployment platform (Vercel, Netlify, Firebase, Cloud Run)

# Backend API URL (leave empty if using Firebase Hosting rewrites or relative path /)
VITE_API_URL=

# Optional: Firebase Web App Configuration
VITE_FIREBASE_PROJECT_ID=your-firebase-project-id
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890abcdef
VITE_FIREBASE_STORAGE_BUCKET=your-firebase-project-id.firebasestorage.app
VITE_FIREBASE_API_KEY=AIzaSyYourFirebaseApiKeyHere12345678
VITE_FIREBASE_AUTH_DOMAIN=your-firebase-project-id.firebaseapp.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_PROJECT_NUMBER=123456789012

# Service account email running the Cloud Run agents (must match studio_sa in terraform/iam.tf)
# Users share their Google Drive folder and template doc with this email
# Get it from: terraform output service_account_email
VITE_STUDIO_SA_EMAIL=community-studio-runtime@your-project-id.iam.gserviceaccount.com

# Local development only: skip Google sign-in (ignored in production builds)
# VITE_DEV_AUTH_BYPASS=true

# --- Google Drive picker (Settings -> Choose folder / template, chat -> Google Drive) ---
# Enable "Google Picker API" in the Cloud project and allow it for the browser API key.
# Optional: OAuth Web client ID for the narrow drive.file scope (only files the user picks).
# Without it the picker reuses the Google sign-in token.
# VITE_GOOGLE_OAUTH_CLIENT_ID=1234567890-xxxx.apps.googleusercontent.com
# VITE_GOOGLE_PICKER_API_KEY=   (defaults to VITE_FIREBASE_API_KEY)
