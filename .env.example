# ==============================================================================
# 🚀 Community AI Studio - Root Environment Configuration (.env)
# ==============================================================================
# Copy this file to .env and replace placeholder values.
# NEVER commit your real .env file with secrets to Git.

# --- 1. GEMINI & VERTEX AI BACKEND CONFIGURATION ---
# Set to 1 to route calls through Google Cloud Vertex AI (requires GCP credentials / ADC).
# Set to 0 to route calls directly through Google AI Studio API key.
GOOGLE_GENAI_USE_VERTEXAI=1
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global

# Preferred Gemini API key (used when GOOGLE_GENAI_USE_VERTEXAI=0 and for Omni video model)
GOOGLE_API_KEY=
# Fallback API key variable
GEMINI_API_KEY=

# --- 2. COMMUNITY & UI BRANDING ---
COMMUNITY_NAME=Your Community Name

# --- 4. VIDEO & MEDIA AI ENGINE SETTINGS ---
# Video Generation Engine: 'omni' (Gemini Omni Flash)
VIDEO_ENGINE=omni
# Toggle which rendering outputs are generated (true/false)
RENDER_ORDINARY=false
RENDER_GIF=false
RENDER_4K=true
# Cover frame: the first frame of the video shows the finished card (full talk title + speaker
# photo), so the LinkedIn/Instagram thumbnail is not an empty canvas. VIDEO_COVER_SECONDS=0 holds
# it for exactly one frame; e.g. 0.5 holds it longer before the intro animation starts.
VIDEO_COVER_FRAME=true
VIDEO_COVER_SECONDS=0

# Video editor conversation and output settings.
# Offline mode: fallback scenarios + bundled sample video, no Gemini/Omni/HyperFrames calls.
# Handy for UI work and chat evals. VIDEO_EDITOR_OFFLINE_RENDER_SECONDS simulates render time.
VIDEO_EDITOR_OFFLINE=false
VIDEO_EDITOR_OFFLINE_RENDER_SECONDS=0
# Render workspaces older than this are deleted automatically.
VIDEO_EDITOR_WORKSPACE_TTL_SECONDS=86400
VIDEO_EDITOR_PROPOSE_TYPO_CORRECTIONS=true

# --- Session storage ---
# Unset locally: SQLite files under agents/<agent>/.adk/. In production deploy/setup_sessions_db.sh
# stores a Cloud SQL URI in Secret Manager, e.g.
# SESSION_SERVICE_URI=postgresql+asyncpg://adk:PASSWORD@/adk_sessions?host=/cloudsql/PROJECT:REGION:community-sessions
SESSION_SERVICE_URI=
# Logging: LOG_LEVEL=DEBUG|INFO|WARNING, LOG_FORMAT=json forces Cloud Logging JSON lines locally.
LOG_LEVEL=INFO

# --- 5. MICROSERVICE & A2A NETWORKING OVERRIDES ---
# Default local ports for multi-agent network (used by launcher and Docker)
VIDEO_AGENT_HOST=localhost
VIDEO_AGENT_PORT=8081
RECEIPT_AGENT_HOST=localhost
RECEIPT_AGENT_PORT=8082

# Optional explicit remote URLs (used in Cloud Run / multi-host deployments)
# VIDEO_AGENT_A2A_URL=https://video-editor-a2a-your-hash-region.a.run.app
# RECEIPT_AGENT_A2A_URL=https://receipt-scanner-a2a-your-hash-region.a.run.app

# --- 6. FRONTEND DEPLOYMENT SETTINGS ---
# VITE_API_URL=https://community-root-agent-your-hash-region.a.run.app
