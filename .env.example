# Copy this file to .env and replace placeholder values. Do not commit .env.
#
# Select exactly one Gemini inference backend.
# Vertex AI mode requires Application Default Credentials:
#   gcloud auth application-default login

# Set to 1 for Vertex AI, or 0 to use GEMINI_API_KEY for all Gemini model calls.
GOOGLE_GENAI_USE_VERTEXAI=1
GOOGLE_CLOUD_PROJECT=YOUR_GCP_PROJECT_ID
GOOGLE_CLOUD_LOCATION=europe-central2

# Required when GOOGLE_GENAI_USE_VERTEXAI=0 and always for VIDEO_ENGINE=omni.
GEMINI_API_KEY=

# Optional Google Drive / Google Docs configuration for receipt report exports.
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_DOCS_TEMPLATE_ID=

# Optional UI and agent branding.
GDG_COMMUNITY_NAME=Krakow

# Video generation settings. Keep disabled during local setup to avoid model usage.
# `veo` requires GOOGLE_GENAI_USE_VERTEXAI=1. Use `omni` when it is 0.
VIDEO_ENGINE=veo
ENABLE_VIDEO_GENERATION=false
RENDER_4K=false
RENDER_ORDINARY=true
RENDER_GIF=false

# Optional service overrides. The launcher supplies its standard A2A URLs.
VIDEO_AGENT_HOST=localhost
VIDEO_AGENT_PORT=8081
RECEIPT_AGENT_HOST=localhost
RECEIPT_AGENT_PORT=8082
