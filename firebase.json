{
  "hosting": {
    "public": "frontend/dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/list-apps",
        "run": {
          "serviceId": "gdg-root-agent",
          "region": "europe-central2"
        }
      },
      {
        "source": "/run",
        "run": {
          "serviceId": "gdg-root-agent",
          "region": "europe-central2"
        }
      },
      {
        "source": "/run_sse",
        "run": {
          "serviceId": "gdg-root-agent",
          "region": "europe-central2"
        }
      },
      {
        "source": "/apps/**",
        "run": {
          "serviceId": "gdg-root-agent",
          "region": "europe-central2"
        }
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
