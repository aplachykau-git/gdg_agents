{
  "hosting": {
    "public": "frontend/dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "/index.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "/",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "/list-apps",
        "run": {
          "serviceId": "gdg-root-agent",
          "region": "europe-central2"
        }
      },
      {
        "source": "/run",
        "run": {
          "serviceId": "gdg-root-agent",
          "region": "europe-central2"
        }
      },
      {
        "source": "/run_sse",
        "run": {
          "serviceId": "gdg-root-agent",
          "region": "europe-central2"
        }
      },
      {
        "source": "/apps/**",
        "run": {
          "serviceId": "gdg-root-agent",
          "region": "europe-central2"
        }
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
