# Virtual Environment
.venv/
venv/
ENV/

# Python caching
**/__pycache__/
*.pyc
*.pyo
*.pyd

# Local environment variables & secrets (recursive)
.env
**/.env
.env.*
!.env.example

# OS generated files
.DS_Store
Thumbs.db

# API Credentials, tokens and keys
token.json
credentials.json
configs/credentials.json
configs/token.json
service_account.json
*.json.key
*.key
*.pem

# Firebase & Cloud cache
.firebase/
firebase-debug.log*
firestore-debug.log*
ui-debug.log*

# Node / Frontend build artifacts
node_modules/
**/node_modules/
dist/
**/dist/
.vite/
**/.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Testing & Coverage cache
.pytest_cache/
.coverage
htmlcov/
.ruff_cache/

# ADK and other runtime cache
.adk/
**/.adk/
*.db
session.db

# Participant Data, Scans, and Generated Outputs (to prevent GDPR/data leaks on GitHub)
**/results/
**/output/
**/*.xlsx
**/*.xls
**/*.csv
**/*.docx
**/*.pdf

# Generated Media and Video Editor Outputs (Renders & Outpainted Images)
**/renders/
**/*.mp4
**/*.gif
**/*.webm
agents/receipt_scanner/evaluation/fixtures/downloaded/

# GDG Organisers lists (to keep sensitive attendee/staff data local)
**/organisers.txt
configs/organisers.txt
